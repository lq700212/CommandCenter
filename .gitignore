# 编译产物
bin/
obj/

# 运行日志
Logs/
debug.log

# 运行时数据（现场维护配置，不入库）
Config/*.json
*.tmp

# VS 用户文件
*.user
.vs/

# opencode 工具本地状态（node_modules 依赖 + 会话计划/记忆，不入库）
# 例外：skills/ 沉淀的调试经验技能要入库共享，其余（node_modules/package.json
# 等）由 .opencode/.gitignore 负责忽略。
.opencode/*
!.opencode/skills/
!.opencode/skills/**

# NuGet 包缓存目录（项目依赖已拷入 CommandCenter/libs/ 直接引用，不靠 restore）
packages/

# WorkBuddy 项目本地数据（会话记忆/日志等，不入库）
.workbuddy/

# ZCode 本地状态（会话计划/临时文件，不入库）
.zcode/