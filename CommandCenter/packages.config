<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 包清单（packages.config）：
  仅供 Visual Studio "管理 NuGet 程序包" 界面识别已安装的包与版本，方便升级对照。
  实际构建不依赖 NuGet restore —— 对应 DLL 已拷入 libs/ 目录经 csproj <Reference HintPath> 引用，
  因此离线/现场环境无需联网还原即可编译。两处版本必须保持一致：

    NModbus         3.0.83     ->  libs\NModbus.dll
    Newtonsoft.Json 13.0.4     ->  libs\Newtonsoft.Json.dll

  升级步骤：先在 VS 用 NuGet 更新此清单版本，再把新 DLL 覆盖进 libs/ 并在 csproj 确认引用。
-->
<packages>
  <package id="NModbus" version="3.0.83" targetFramework="net472" />
  <package id="Newtonsoft.Json" version="13.0.4" targetFramework="net472" />
</packages>